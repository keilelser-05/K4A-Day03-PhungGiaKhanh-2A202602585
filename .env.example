# DAY 03 — ReAct Agent + REAL MCP + Google Calendar
# Copy to .env and fill your own key locally. NEVER commit .env.

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6

# google = real Google Calendar; mock = deterministic offline Calendar backend
CALENDAR_BACKEND=google
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=Asia/Ho_Chi_Minh
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events

# Keep false on a personal Calendar unless intentionally running the 5-case suite.
ALLOW_GOOGLE_WRITE_TESTS=false
